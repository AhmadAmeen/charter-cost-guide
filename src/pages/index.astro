---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_NAME } from '../config';

const allGuides = await getCollection('guides');
const bySlug = (slug: string) => allGuides.find((g) => g.data.urlSlug === slug);
const hubLabel = (hub: string) => ({ 'yacht-charter': 'Yacht Charter', 'private-jets': 'Private Jets', 'planning': 'Planning' }[hub] ?? hub);

// Trending picks (curated). guideImages map kept from previous homepage for card photos.
const trending = [
  { slug: 'crewed-vs-bareboat', badge: 'Most read' },
  { slug: 'popular-routes-prices', badge: 'New' },
  { slug: 'crew-tipping-guide', badge: 'Trending' },
  { slug: 'charter-vs-first-class', badge: 'Planning' },
  { slug: 'best-time-to-charter-by-destination', badge: 'Planning' },
].map((t) => ({ ...t, guide: bySlug(t.slug) })).filter((t) => t.guide);

const guideImages: Record<string, { src: string; alt: string }> = {
  'yacht-charter/cost': { src: 'https://images.unsplash.com/photo-1777305232325-09f48919f077?q=80&w=800&auto=format&fit=crop', alt: 'Yachts docked in a sunny marina' },
  'yacht-charter/how-to-charter-a-yacht': { src: 'https://images.unsplash.com/photo-1759069580619-3f03daa36157?q=80&w=800&auto=format&fit=crop', alt: 'Sailboats anchored in a calm bay' },
  'yacht-charter/greece-vs-croatia-vs-italy': { src: 'https://images.pexels.com/photos/31326411/pexels-photo-31326411.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Yachts docked in a Mediterranean marina' },
  'private-jets/cost': { src: 'https://images.unsplash.com/photo-1474302770737-173ee21bab63?q=80&w=800&auto=format&fit=crop', alt: 'Private jet parked on the tarmac at sunset' },
  'yacht-charter/how-brokers-get-paid': { src: 'https://images.unsplash.com/photo-1672380135241-c024f7fbfa13?q=80&w=800&auto=format&fit=crop', alt: 'Two people shaking hands over a broker agreement' },
  'yacht-charter/dubai-uae': { src: 'https://images.unsplash.com/photo-1768463852019-4881a17a1c0e?q=80&w=800&auto=format&fit=crop', alt: 'Yacht sailing in Dubai Marina at sunset with the city skyline' },
  'yacht-charter/events-birthdays-weddings': { src: 'https://images.pexels.com/photos/7766408/pexels-photo-7766408.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Elegant table setting on a yacht deck at sea in daylight' },
  'yacht-charter/hidden-costs-checklist': { src: 'https://images.pexels.com/photos/8117665/pexels-photo-8117665.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Aerial view of yachts docked in a marina on calm blue water' },
  'private-jets/charter-safety-checklist': { src: 'https://images.pexels.com/photos/6965/sky-flying-summer-aviation.jpg?auto=compress&cs=tinysrgb&w=800', alt: 'Two pilots in a private jet cockpit at sunrise' },
  'private-jets/tipping-guide': { src: 'https://images.pexels.com/photos/30773896/pexels-photo-30773896.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Private jet taxiing on an airport tarmac under a clear blue sky' },
  'yacht-charter/catamaran-vs-motor-vs-sailing': { src: 'https://images.pexels.com/photos/32509685/pexels-photo-32509685.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Aerial view of a luxury catamaran anchored in clear turquoise water' },
  'private-jets/how-to-charter-a-private-jet': { src: 'https://images.pexels.com/photos/31203793/pexels-photo-31203793.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Private jet parked on a runway in a scenic setting' },
  'planning/best-time-to-charter-by-destination': { src: 'https://images.pexels.com/photos/29764490/pexels-photo-29764490.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Sailboat gliding on calm blue Mediterranean water with green hills in the background' },
  'yacht-charter/caribbean': { src: 'https://images.pexels.com/photos/7981728/pexels-photo-7981728.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Catamaran sailing in turquoise Caribbean water under a blue sky' },
  'private-jets/group-travel-vs-commercial': { src: 'https://images.pexels.com/photos/5778226/pexels-photo-5778226.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Passenger reading a newspaper in a private jet cabin with leather seats' },
  'private-jets/pets-luggage-catering': { src: 'https://images.pexels.com/photos/14914172/pexels-photo-14914172.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Leather seats inside a private jet cabin' },
  'planning/charter-glossary': { src: 'https://images.pexels.com/photos/15141410/pexels-photo-15141410.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Binoculars and compass on a wooden table in a boat cockpit' },
  'planning/luxury-group-trip-checklist': { src: 'https://images.pexels.com/photos/15141382/pexels-photo-15141382.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Group of friends chatting on a boat deck' },
  'planning/charter-travel-insurance-checklist': { src: 'https://images.pexels.com/photos/7235894/pexels-photo-7235894.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Passport on a travel planner with a map' },
  'planning/yacht-charter-vs-luxury-cruise': { src: 'https://images.pexels.com/photos/13386019/pexels-photo-13386019.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Aerial view of a luxury motor yacht on turquoise water' },
  'planning/yacht-and-island-holiday-ideas-by-budget': { src: 'https://images.pexels.com/photos/8299833/pexels-photo-8299833.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Yacht anchored near a rocky island shore' },
  'planning/charter-contracts-and-cancellations': { src: 'https://images.pexels.com/photos/955393/pexels-photo-955393.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Hand signing a contract with a pen' },
  'yacht-charter/crew-tipping-guide': { src: 'https://images.unsplash.com/photo-1773834194438-f8325273c655?w=800&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D', alt: 'Sailing crew working on the deck of a heeling yacht' },
  'yacht-charter/mediterranean': { src: 'https://images.pexels.com/photos/36532616/pexels-photo-36532616.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Sailboat anchored in a turquoise Mediterranean cove' },
  'private-jets/jet-card-vs-on-demand-vs-fractional': { src: 'https://images.pexels.com/photos/28772726/pexels-photo-28772726.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Private jet parked on the tarmac at sunset' },
  'yacht-charter/apa-explained': { src: 'https://images.pexels.com/photos/5230616/pexels-photo-5230616.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Aerial view of a yacht floating on dark blue sea' },
  'private-jets/light-vs-midsize-vs-large': { src: 'https://images.unsplash.com/photo-1684838200815-36eef38f353c?q=60&w=800&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D', alt: 'White private jet parked on an airport tarmac at sunset' },
  'private-jets/charter-vs-first-class': { src: 'https://images.pexels.com/photos/20584536/pexels-photo-20584536.jpeg?auto=compress&cs=tinysrgb&w=800', alt: 'Empty leather aircraft seats beside cabin windows' },
  'yacht-charter/crewed-vs-bareboat': { src: 'https://images.unsplash.com/photo-1777456404471-619ccaa5ded6?q=60&w=800&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D', alt: 'Sailing yacht with dark sails on the open ocean' },
  'private-jets/popular-routes-prices': { src: 'https://images.unsplash.com/photo-1558285549-2a06f9a5fe65?q=60&w=800&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D', alt: 'Aircraft wing above white clouds at sunset' },
  'private-jets/empty-leg-flights': { src: 'https://images.unsplash.com/photo-1678419214383-2391a9118c24?q=60&w=800&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D', alt: 'Business jet approaching with landing gear down at sunset' },
};
const cardImg = (hub: string, slug: string) => guideImages[`${hub}/${slug}`];
---

<Base
  title={SITE_NAME}
  description="Independent, plain-English guides to yacht and private jet charter costs, contracts and booking — with sourced prices and dates on every page."
>
  <!-- ============ HERO + ESTIMATOR ============ -->
  <section class="dyn-hero" aria-label="Introduction">
    <div class="dyn-hero-bg" aria-hidden="true"></div>
    <div class="dyn-hero-veil" aria-hidden="true"></div>
    <div class="container dyn-hero-inner">
      <div class="dyn-hero-copy">
        <p class="eyebrow" style="color: var(--brass-300);">Independent charter cost guides</p>
        <h1>Know what a charter really costs.</h1>
        <p class="lede">Plain-English yacht and private jet price guides with sourced figures and dates — no sponsored rankings, no invented numbers. Start with a 30-second estimate.</p>
        <div class="dyn-hero-points">
          <span><b>✓</b> Sourced prices</span>
          <span><b>✓</b> Updated Oct 2026</span>
          <span><b>✓</b> No sponsored rankings</span>
        </div>
      </div>
      <div class="dyn-est" id="estimator">
        <div class="dyn-est-tabs" role="tablist" aria-label="Estimate type">
          <button class="dyn-est-tab active" data-etab="yacht" role="tab" aria-selected="true">⛵ Yacht estimate</button>
          <button class="dyn-est-tab" data-etab="jet" role="tab" aria-selected="false">✈ Jet estimate</button>
        </div>
        <div class="dyn-est-body" id="est-yacht" role="tabpanel">
          <label for="ytype">Yacht type</label>
          <select id="ytype">
            <option value="bareboat">Bareboat sailing yacht — €3.5k–9k / week</option>
            <option value="small">Small crewed yacht / catamaran — from $10k / week</option>
            <option value="midcat" selected>Mid-size crewed catamaran — $15k–45k / week</option>
            <option value="motor80100">Motor yacht, 80–100 ft — $41k–94k / week</option>
            <option value="large">Large motor yacht — $100k+ / week</option>
          </select>
          <label for="yweeks">Duration</label>
          <div class="dyn-est-row">
            <input type="range" id="yweeks" min="1" max="4" value="1" step="1" aria-label="Charter duration in weeks" />
            <span class="dyn-est-val" id="yweeks-v">1 week</span>
          </div>
          <div class="dyn-est-out"><span class="lbl">Estimated all-in</span><span class="num" id="yout">$21k – $63k</span></div>
          <p class="dyn-est-note">Base fee × weeks × 1.4 (adds ~30% APA + ~10% tip). Indicative only.</p>
          <a class="dyn-est-link" href="/yacht-charter/cost/">Read the full yacht cost guide →</a>
        </div>
        <div class="dyn-est-body" id="est-jet" role="tabpanel" hidden>
          <label for="jtype">Aircraft size</label>
          <select id="jtype">
            <option value="light" selected>Light jet (6 seats) — $3.5k–6.5k / hour</option>
            <option value="mid">Midsize jet (8 seats) — $4.5k–8.5k / hour</option>
            <option value="heavy">Large / heavy jet (12+ seats) — $7k–13k / hour</option>
          </select>
          <label for="jhours">Flight time</label>
          <div class="dyn-est-row">
            <input type="range" id="jhours" min="1" max="10" value="2" step="1" aria-label="Flight time in hours" />
            <span class="dyn-est-val" id="jhours-v">2 hrs</span>
          </div>
          <div class="dyn-est-out"><span class="lbl">Estimated all-in</span><span class="num" id="jout">$8k – $15k</span></div>
          <p class="dyn-est-note">Hourly rate × hours + ~15% taxes &amp; fees. Positioning can add more.</p>
          <a class="dyn-est-link" href="/private-jets/cost/">Read the full jet cost guide →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST COUNTERS ============ -->
  <div class="dyn-trust">
    <div class="container dyn-trust-grid">
      <div class="rv"><div class="dyn-trust-num"><span class="count" data-to="31">0</span></div><div class="dyn-trust-lbl">in-depth cost guides</div></div>
      <div class="rv"><div class="dyn-trust-num"><span class="count" data-to="100">0</span><em>+</em></div><div class="dyn-trust-lbl">sourced prices with dates</div></div>
      <div class="rv"><div class="dyn-trust-num"><span class="count" data-to="0">0</span></div><div class="dyn-trust-lbl">sponsored rankings</div></div>
      <div class="rv"><div class="dyn-trust-num"><em>Oct</em> 2026</div><div class="dyn-trust-lbl">last price refresh</div></div>
    </div>
  </div>

  <div class="container">
    <!-- ============ PRICE TABS ============ -->
    <section class="section" aria-label="Charter prices at a glance">
      <div class="rv"><p class="eyebrow">At a glance</p>
      <h2>Charter prices, without the sales pitch</h2>
      <p class="dyn-sub">Indicative ranges from published 2026 broker guides. Every figure on this site carries a source and a date.</p></div>
      <div class="dyn-ptabs rv" role="tablist" aria-label="Price tables">
        <button class="dyn-ptab active" data-ptab="py" role="tab" aria-selected="true">⛵ Yachts <span>/ week</span></button>
        <button class="dyn-ptab" data-ptab="pj" role="tab" aria-selected="false">✈ Jets <span>/ hour</span></button>
      </div>
      <div class="dyn-ptable-wrap rv">
        <table class="dyn-ptable active" id="py">
          <thead><tr><th>Yacht type</th><th>Indicative base fee</th><th>Good to know</th></tr></thead>
          <tbody>
            <tr><td>Bareboat sailing yacht</td><td class="range">€3,500 – €9,000</td><td>Excludes fuel &amp; marina fees; licence required</td></tr>
            <tr><td>Small crewed yacht / catamaran</td><td class="range">from $10,000</td><td>Entry point for crewed charter</td></tr>
            <tr><td>Mid-size crewed catamaran</td><td class="range">$15,000 – $45,000</td><td>Popular for families &amp; groups</td></tr>
            <tr><td>Motor yacht, 80–100 ft</td><td class="range">$41,000 – $94,000</td><td>Plus ~30% APA and ~10% tip on top</td></tr>
            <tr><td>Large motor yacht</td><td class="range">$100,000+</td><td>APA near 35% at this level</td></tr>
          </tbody>
        </table>
        <table class="dyn-ptable" id="pj" hidden>
          <thead><tr><th>Jet size</th><th>Indicative hourly rate</th><th>Good to know</th></tr></thead>
          <tbody>
            <tr><td>Light jet (6 seats)</td><td class="range">$3,500 – $6,500</td><td>A 2-hr trip ≈ $7k–$13k before fees</td></tr>
            <tr><td>Midsize jet (8 seats)</td><td class="range">$4,500 – $8,500</td><td>Sweet spot for 3–4 hr trips</td></tr>
            <tr><td>Large / heavy jet (12+ seats)</td><td class="range">$7,000 – $13,000</td><td>Intercontinental range</td></tr>
          </tbody>
        </table>
      </div>
      <p class="fine">Figures are indicative and move with season, route and availability. Sources &amp; access dates on every guide.</p>
    </section>

    <!-- ============ START HERE ============ -->
    <section class="section" aria-label="Start here">
      <div class="rv"><p class="eyebrow">Start here</p>
      <h2>New to chartering?</h2>
      <p class="dyn-sub">Three guides that answer 80% of first-timer questions.</p></div>
      <div class="card-grid dyn-cards">
        <Card
          kicker="Yacht Charter"
          title="Yacht charter costs"
          description="Base fee, APA, tax and tips explained with worked examples."
          href="/yacht-charter/cost/"
          image="https://images.unsplash.com/photo-1774990044517-cff3f41a6ad9?q=80&w=800&auto=format&fit=crop"
          imageAlt="Boats docked in a calm marina on a clear day"
        />
        <Card
          kicker="Private Jets"
          title="Private jet costs"
          description="What per-hour pricing really means for your trip."
          href="/private-jets/cost/"
          image="https://images.unsplash.com/photo-1759614581731-4c7090648de0?q=80&w=800&auto=format&fit=crop"
          imageAlt="Private jet on the tarmac"
        />
        <Card
          kicker="Private Jets"
          title="Empty leg flights"
          description="When discounted one-way flights make sense, and when they do not."
          href="/private-jets/empty-leg-flights/"
          image="https://images.unsplash.com/photo-1474302770737-173ee21bab63?q=80&w=800&auto=format&fit=crop"
          imageAlt="Private jet on the tarmac at sunset"
        />
      </div>
    </section>

    <!-- ============ TRENDING ============ -->
    <section class="section" aria-label="Trending guides">
      <div class="rv"><p class="eyebrow">Trending this week</p>
      <h2>What readers are comparing</h2>
      <p class="dyn-sub">The guides getting the most attention right now.</p></div>
      <div class="dyn-trend-wrap rv">
        <div class="dyn-trend-row" id="trow">
          {trending.map((t) => {
            const g = t.guide!;
            const gi = cardImg(g.data.hub, g.data.urlSlug);
            return (
              <a class="dyn-tcard" href={`/${g.data.hub}/${g.data.urlSlug}/`}>
                <span class="dyn-tcard-art">
                  <span class="dyn-badge">{t.badge}</span>
                  {gi ? <img loading="lazy" decoding="async" src={gi.src} alt={gi.alt} /> : null}
                </span>
                <span class="dyn-tcard-tx">
                  <span class="card-kicker">{hubLabel(g.data.hub)}</span>
                  <span class="dyn-tcard-title">{g.data.title}</span>
                  <span class="dyn-tcard-desc">{g.data.description}</span>
                </span>
              </a>
            );
          })}
        </div>
        <div class="dyn-tnav">
          <button id="tprev" aria-label="Scroll trending left">←</button>
          <button id="tnext" aria-label="Scroll trending right">→</button>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ RESEARCH BAND ============ -->
  <section class="band-dark" aria-label="How we research">
    <div class="container section">
      <div class="rv"><p class="eyebrow" style="color: var(--brass-300);">How we research</p>
      <h2 style="color: var(--ivory);">Independent numbers, or nothing</h2>
      <p class="dyn-sub" style="color: #aeb9c6;">Every price on this site is traceable to a published source with an access date. If we can't source it, we leave the cell blank.</p></div>
      <div class="dyn-steps">
        <div class="dyn-step rv"><div class="n">01</div><h3>Collect</h3><p>We pull 2026 figures from broker guides, fleet rate reports and operator price lists — never from thin air.</p></div>
        <div class="dyn-step rv"><div class="n">02</div><h3>Date everything</h3><p>Each figure carries its source and access date, so you can judge freshness before you trust it.</p></div>
        <div class="dyn-step rv"><div class="n">03</div><h3>No sponsored ranks</h3><p>Our guides never rank providers for pay. Affiliate links are disclosed and never affect the numbers.</p></div>
      </div>
    </div>
  </section>

  <div class="container">
    <!-- ============ FAQ TEASER ============ -->
    <section class="section" aria-label="Frequently asked questions">
      <div class="rv"><p class="eyebrow">Quick answers</p>
      <h2>Asked all the time</h2>
      <p class="dyn-sub">Straight answers, no sales call required.</p></div>
      <div class="dyn-faq rv">
        <div class="dyn-faq-item"><button class="dyn-faq-q" aria-expanded="false">What's the cheapest way to charter a yacht?<span class="ch" aria-hidden="true">+</span></button><div class="dyn-faq-a"><div>A bareboat sailing yacht in shoulder season — roughly €3,500–€9,000 per week before fuel — is the floor. You sail it yourself and need the right licence.</div></div></div>
        <div class="dyn-faq-item"><button class="dyn-faq-q" aria-expanded="false">Are empty leg flights really 75% cheaper?<span class="ch" aria-hidden="true">+</span></button><div class="dyn-faq-a"><div>Discounts of 25–75% are commonly cited, because the operator would otherwise fly empty. The trade-off: fixed route, date and time, and the flight can change.</div></div></div>
        <div class="dyn-faq-item"><button class="dyn-faq-q" aria-expanded="false">What does APA mean on a yacht quote?<span class="ch" aria-hidden="true">+</span></button><div class="dyn-faq-a"><div>Advance Provisioning Allowance — typically 25–35% of the base fee, held upfront to cover fuel, food, dockage and drinks. Unused funds are refunded.</div></div></div>
        <div class="dyn-faq-item"><button class="dyn-faq-q" aria-expanded="false">Is a private jet ever cheaper than first class?<span class="ch" aria-hidden="true">+</span></button><div class="dyn-faq-a"><div>Per seat, rarely — but for groups of 6+ on the right route, the per-person maths can get surprisingly close. <a href="/private-jets/charter-vs-first-class/">Our comparison guide</a> runs the numbers.</div></div></div>
      </div>
    </section>

    <section class="section narrow" aria-label="How we earn money">
      <h2>How we earn money</h2>
      <p>This site is free to read. When you request a quote or book through some links, the provider may pay us a commission. It does not change the price you pay, and we do not accept payment to change what our guides say.</p>
    </section>
    <Newsletter />
  </div>

<script>
(function(){
  "use strict";
  // ---------- estimator (real published ranges from our guides) ----------
  var YACHT = {
    bareboat:{cur:'€',low:3500,high:9000},
    small:{cur:'$',low:10000,high:null},
    midcat:{cur:'$',low:15000,high:45000},
    motor80100:{cur:'$',low:41000,high:94000},
    large:{cur:'$',low:100000,high:null}
  };
  var JET = { light:{low:3500,high:6500}, mid:{low:4500,high:8500}, heavy:{low:7000,high:13000} };
  function fmt(n){ return n>=1000 ? (Math.round(n/100)/10).toString().replace(/\.0$/,'')+'k' : String(Math.round(n)); }
  function yachtCalc(){
    var t = YACHT[document.getElementById('ytype').value];
    var w = +document.getElementById('yweeks').value;
    document.getElementById('yweeks-v').textContent = w + (w>1?' weeks':' week');
    var lo = Math.round(t.low*w*1.4), hi = t.high ? Math.round(t.high*w*1.4) : null;
    document.getElementById('yout').textContent = t.cur + fmt(lo) + (hi ? ' – '+t.cur+fmt(hi) : '+');
  }
  function jetCalc(){
    var t = JET[document.getElementById('jtype').value];
    var h = +document.getElementById('jhours').value;
    document.getElementById('jhours-v').textContent = h + (h>1?' hrs':' hr');
    document.getElementById('jout').textContent = '$'+fmt(Math.round(t.low*h*1.15))+' – $'+fmt(Math.round(t.high*h*1.15));
  }
  ['ytype','yweeks'].forEach(function(id){ var el=document.getElementById(id); if(el) el.addEventListener(id==='ytype'?'change':'input', yachtCalc); });
  ['jtype','jhours'].forEach(function(id){ var el=document.getElementById(id); if(el) el.addEventListener(id==='jtype'?'change':'input', jetCalc); });
  yachtCalc(); jetCalc();
  // ---------- tabs ----------
  function wireTabs(tabSel, panelAttr){
    document.querySelectorAll(tabSel).forEach(function(b){
      b.addEventListener('click', function(){
        var scope = b.closest('section') || b.closest('.dyn-est') || document;
        scope.querySelectorAll(tabSel).forEach(function(x){ x.classList.remove('active'); x.setAttribute('aria-selected','false'); });
        b.classList.add('active'); b.setAttribute('aria-selected','true');
        document.querySelectorAll('['+panelAttr+']').forEach(function(){});
        var target = document.getElementById(b.dataset.etab ? 'est-' + b.dataset.etab : b.dataset.ptab);
        var sib = b.parentElement ? Array.prototype.slice.call(b.parentElement.parentElement.querySelectorAll('.dyn-est-body,.dyn-ptable')) : [];
        sib.forEach(function(p){ p.hidden = true; p.classList.remove('active'); });
        if(target){ target.hidden = false; target.classList.add('active'); }
      });
    });
  }
  wireTabs('.dyn-est-tab'); wireTabs('.dyn-ptab');
  // ---------- counters ----------
  var cio = new IntersectionObserver(function(es){ es.forEach(function(e){
    if(!e.isIntersecting) return;
    var el=e.target, to=+el.dataset.to, t0=performance.now();
    (function tick(t){ var p=Math.min(1,(t-t0)/1200);
      el.textContent=Math.round(to*(1-Math.pow(1-p,3)));
      if(p<1) requestAnimationFrame(tick); })(t0);
    cio.unobserve(el);
  });},{threshold:.5});
  document.querySelectorAll('.count').forEach(function(el){ cio.observe(el); });
  // ---------- reveal ----------
  var ro = new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); ro.unobserve(e.target); } }); },{threshold:.1});
  document.querySelectorAll('.rv').forEach(function(el){ ro.observe(el); });
  // ---------- faq ----------
  document.querySelectorAll('.dyn-faq-q').forEach(function(q){
    q.addEventListener('click', function(){
      var item=q.parentElement, ans=item.querySelector('.dyn-faq-a'), open=item.classList.contains('open');
      document.querySelectorAll('.dyn-faq-item.open').forEach(function(o){ o.classList.remove('open'); o.querySelector('.dyn-faq-a').style.maxHeight=null; o.querySelector('.dyn-faq-q').setAttribute('aria-expanded','false'); });
      if(!open){ item.classList.add('open'); ans.style.maxHeight=ans.scrollHeight+'px'; q.setAttribute('aria-expanded','true'); }
    });
  });
  // ---------- carousel ----------
  var row=document.getElementById('trow');
  var prev=document.getElementById('tprev'), next=document.getElementById('tnext');
  if(prev&&row) prev.addEventListener('click',function(){ row.scrollBy({left:-360,behavior:'smooth'}); });
  if(next&&row) next.addEventListener('click',function(){ row.scrollBy({left:360,behavior:'smooth'}); });
  // ---------- reduced motion ----------
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('in'); });
  }
})();
</script>
</Base>
