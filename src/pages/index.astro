---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import CostTable from '../components/CostTable.astro';
import HeroFallback from '../components/HeroFallback.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_NAME } from '../config';

const guides = (await getCollection('guides'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 6);

const glanceColumns = ['Item', 'Indicative range', 'What changes it'];
const glanceRows = [
  ['Crewed yacht, weekly base fee', 'From about $10,000 (small sailing yacht or catamaran) to $100,000+ (large motor yachts)', 'Size, season, region'],
  ['APA (running-costs deposit)', 'About 25 to 40% of the base fee', 'Fuel, food, dockage'],
  ['Crew tip', 'Around 10% of the base fee is commonly suggested, lower on very large yachts', 'Service level, yacht size'],
  ['Bareboat sailing yacht', 'Roughly 3,500 to 9,000 euros per week before fuel and marina fees', 'Boat, region'],
  ['Private jet, per flight hour', 'Light about $3,000 to $6,500; midsize about $4,500 to $8,500; large cabin about $7,000 to $13,000+', 'Aircraft, route'],
  ['Empty leg flights', 'Often cited at 25 to 75% off the full charter price, one-way only', 'Route, date flexibility'],
];

const trustItems = [
  { title: 'Sources and dates on every guide', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'Plain-English cost breakdowns', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { title: 'We explain exactly how we earn money', icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9' },
];
---

<Base
  title={SITE_NAME}
  description="Independent, plain-English guides to yacht and private jet charter costs, contracts and booking — with sourced prices and dates on every page."
>
  <section class="hero band-dark" aria-label="Introduction">
    <svg class="hero-waves" viewBox="0 0 1600 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="#B08D4F" stroke-width="1" opacity="0.14">
        <path d="M-20 100 Q 180 60, 380 100 T 780 100 T 1180 100 T 1580 100 T 1980 100" />
        <path d="M-20 200 Q 180 160, 380 200 T 780 200 T 1180 200 T 1580 200 T 1980 200" />
        <path d="M-20 300 Q 180 260, 380 300 T 780 300 T 1180 300 T 1580 300 T 1980 300" />
        <path d="M-20 400 Q 180 360, 380 400 T 780 400 T 1180 400 T 1580 400 T 1980 400" />
        <path d="M-20 500 Q 180 460, 380 500 T 780 500 T 1180 500 T 1580 500 T 1980 500" />
      </g>
    </svg>
    <div class="container">
      <div class="hero-inner hero-animate">
        <p class="eyebrow">Independent charter guides</p>
        <h1>Know what a charter really costs before you ask for a quote.</h1>
        <p class="lede">Plain-English guides to yacht and private jet charter pricing, contracts and booking, with sources and dates on every page.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/yacht-charter/">See yacht charter costs</a>
          <a class="btn btn-secondary" href="/private-jets/">How empty legs work</a>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="trust-strip" aria-label="Why trust us">
      {trustItems.map((item) => (
        <div class="trust-item">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B08D4F" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={item.icon} /></svg>
          <span>{item.title}</span>
        </div>
      ))}
    </section>

    <section class="section" aria-label="Start here" style="padding-top: 0;">
      <h2>Start here</h2>
      <div class="card-grid">
        <Card
          kicker="Yacht Charter"
          title="Yacht charter costs"
          description="Base fee, APA, tax and tips explained with worked examples."
          href="/yacht-charter/cost/"
        />
        <Card
          kicker="Private Jets"
          title="Private jet costs"
          description="What per-hour pricing really means for your trip."
          href="/private-jets/"
        />
        <Card
          kicker="Private Jets"
          title="Empty leg flights"
          description="When discounted one-way flights make sense, and when they do not."
          href="/private-jets/"
        />
      </div>
    </section>

    <section class="section narrow" aria-label="Charter prices at a glance" style="padding-top: 0;">
      <h2>Charter prices at a glance</h2>
      <p>Indicative ranges compiled from published provider guides. Real quotes vary by season, route and operator.</p>
      <CostTable
        title="Indicative charter price ranges"
        columns={glanceColumns}
        rows={glanceRows}
        source="YachtCharterFleet, LuxuryCharterGroup, BoatCrowd, BlackJet, SkyAccess and GlobalCharter published guides"
        dataAsOf="13 October 2026"
      />
      <p>Sources and dates are shown in each linked guide.</p>
    </section>

    {guides.length > 0 && (
      <section class="section" aria-label="Latest guides" style="padding-top: 0;">
        <h2>Latest guides</h2>
        <div class="card-grid">
          {guides.map((g) => (
            <Card
              kicker={{ 'yacht-charter': 'Yacht Charter', 'private-jets': 'Private Jets', 'planning': 'Planning' }[g.data.hub]}
              title={g.data.title}
              description={g.data.description}
              href={`/${g.data.hub}/${g.data.urlSlug}/`}
            />
          ))}
        </div>
      </section>
    )}
  </div>

  <section class="band-dark" aria-label="How we research">
    <div class="container section">
      <h2 style="color: var(--ivory);">How we research</h2>
      <div class="research-cols">
        <div>
          <h3>Compare</h3>
          <p>We compare published rates from several brokers and operators.</p>
        </div>
        <div>
          <h3>Date</h3>
          <p>Every price table shows when the data was collected.</p>
        </div>
        <div>
          <h3>Disclose</h3>
          <p>Some links are affiliate links. We may earn a commission at no extra cost to you.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="section narrow" aria-label="How we earn money">
      <h2>How we earn money</h2>
      <p>This site is free to read. When you request a quote or book through some links, the provider may pay us a commission. It does not change the price you pay, and we do not accept payment to change what our guides say.</p>
    </section>
    <Newsletter />
  </div>
</Base>
