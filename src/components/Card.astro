---
interface Props {
  kicker: string;
  title: string;
  description: string;
  href: string;
  image?: string;
  imageAlt?: string;
}
const { kicker, title, description, href, image, imageAlt } = Astro.props;
---

<article class="card">
  {image ? (
    <div class="card-art card-art-photo">
      <img src={image} alt={imageAlt ?? ''} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="card-art" aria-hidden="true">
      <svg width="72" height="45" viewBox="0 0 160 100" aria-hidden="true">
        <g fill="none" stroke="#B08D4F" stroke-width="1.5" opacity="0.8">
          <path d="M0 20 Q 20 12, 40 20 T 80 20 T 120 20 T 160 20" />
          <path d="M0 45 Q 20 37, 40 45 T 80 45 T 120 45 T 160 45" />
          <path d="M0 70 Q 20 62, 40 70 T 80 70 T 120 70 T 160 70" />
        </g>
        <rect x="74" y="8" width="12" height="12" transform="rotate(45 80 14)" fill="#D6BC85" />
      </svg>
    </div>
  )}
  <div class="card-body">
    <span class="card-kicker">{kicker}</span>
    <h3 class="card-title"><a href={href}>{title}</a></h3>
    <p class="card-desc">{description}</p>
    <a class="card-link" href={href} aria-label={`Read the guide: ${title}`}>Read the guide <span class="arrow" aria-hidden="true">→</span></a>
  </div>
</article>
