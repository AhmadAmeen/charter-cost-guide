<style>
  label { display: block; font-weight: 600; font-size: 0.9rem; margin: 0.6rem 0 0.25rem; }
  select { width: 100%; min-height: 48px; font-size: 1rem; padding: 0.5rem 0.75rem; border: 1px solid #b9b2a4; border-radius: 6px; background: #fff; }
  select:focus-visible { outline: 3px solid #2a5db0; outline-offset: 2px; }
</style>
<div>
  <label for="y-season">Season</label>
  <select id="y-season">
    <option value="high" selected>High (Jul-Aug)</option>
    <option value="shoulder">Shoulder (May-Jun, Sep)</option>
    <option value="low">Low (Oct-Apr)</option>
  </select>
</div>
<div>
  <label for="y-region">Region</label>
  <select id="y-region">
    <option value="med" selected>Med</option>
    <option value="caribbean">Caribbean</option>
    <option value="other">Other</option>
  </select>
</div>
